# Cangjie / Harmony Full Pass staging protocol
#
# 用法：
#   cp .env.full-pass.example .env.full-pass.local
#   根据宿主实际路径修改下面的值
#   set -a; source .env.full-pass.local; set +a
#   若已有 host probe + DevEco 工程，可先运行：
#   python scripts/find_harmony_artifact.py --project-root <DevEcoProjectRoot> --host-probe-json artifacts/environment/full-pass-host-profile.windows.json --target-name "<TargetName>" --format env
#
# 设计原则：
# 1. 先声明“设备/应用/日志/状态”的事实参数；
# 2. 再派生为 refresh harness 可直接调用的原子命令；
# 3. 不在仓库中保存任何真实密钥、真实设备序列号或私有路径。

# -----------------------------------------------------------------------------
# Host / toolchain identity
# -----------------------------------------------------------------------------
FULL_PASS_HOST_OS="macos"
FULL_PASS_DEVECO_STUDIO_HOME="/Applications/DevEco Studio.app/Contents"
FULL_PASS_HARMONY_SDK_HOME="$HOME/Library/DevEcoStudio/sdk"
FULL_PASS_HDC_PATH="$FULL_PASS_HARMONY_SDK_HOME/default/openharmony/toolchains/hdc"
FULL_PASS_HOST_PROBE_JSON="artifacts/environment/full-pass-host-profile.json"

# Windows Git-Bash 参考（按需替换上面的 macOS 值，不要两套同时启用）：
# FULL_PASS_HOST_OS="windows"
# FULL_PASS_DEVECO_STUDIO_HOME="C:/Program Files/DevEco Studio"
# FULL_PASS_HARMONY_SDK_HOME="C:/Users/<you>/AppData/Local/DevEcoStudio/sdk"
# FULL_PASS_HDC_PATH="$FULL_PASS_HARMONY_SDK_HOME/default/openharmony/toolchains/hdc.exe"

# -----------------------------------------------------------------------------
# Device topology
# -----------------------------------------------------------------------------
# 指向唯一目标，避免多设备串扰。
FULL_PASS_TARGET_TYPE="emulator"
FULL_PASS_HDC_SERIAL="emulator-5554"
FULL_PASS_TARGET_ID="$FULL_PASS_HDC_SERIAL"
FULL_PASS_TARGET_NAME="Harmony Emulator"
FULL_PASS_TARGET_OS_VERSION="5.0.0"
FULL_PASS_TARGET_SERIAL_REDACTED="true"

# -----------------------------------------------------------------------------
# App lifecycle
# -----------------------------------------------------------------------------
# install / launch 的唯一事实来源，禁止在脚本中另写一套包名或 Ability 名。
FULL_PASS_PKG_NAME="org.example.rms"
FULL_PASS_ABILITY_NAME="EntryAbility"
FULL_PASS_BUNDLE_NAME="$FULL_PASS_PKG_NAME"
FULL_PASS_HAP_PATH="/absolute/path/to/real-message-service.hap"
FULL_PASS_ARTIFACT_PATH="$FULL_PASS_HAP_PATH"
FULL_PASS_BUILD_ID="full-pass-build-001"

# -----------------------------------------------------------------------------
# Module / BCM scope
# -----------------------------------------------------------------------------
FULL_PASS_MODULE_NAME="RealMessageService"
FULL_PASS_UI_ROUTE="/chat/detail"
FULL_PASS_PEER_SCOPE="dialog:42"
FULL_PASS_SCENARIO_MODE="bcm"
FULL_PASS_EXPECTED_ASSERTIONS="BCM-CONC-001,BCM-STATE-001,BCM-ASYNC-003"
# For smoke-only app samples, switch to:
# FULL_PASS_SCENARIO_MODE="smoke"
# FULL_PASS_EXPECTED_ASSERTIONS="SMOKE-LAUNCH-001"

# -----------------------------------------------------------------------------
# Log streaming
# -----------------------------------------------------------------------------
# 只保留运行时/断言核心标签，避免系统噪声淹没证据链。
FULL_PASS_HILOG_FILTER="(BCM-|BCM_TRACE|CangjieRuntime|RMS_|RMS|REFRESH|DATASET|FETCH|SEND|THREAD_CONTEXT)"
FULL_PASS_LOG_FILTER_REGEX="$FULL_PASS_HILOG_FILTER"
FULL_PASS_LOG_CAPTURE_CMD="\"$FULL_PASS_HDC_PATH\" -t \"$FULL_PASS_HDC_SERIAL\" shell hilog"
FULL_PASS_REDACTION_APPLIED="true"

# -----------------------------------------------------------------------------
# State sandboxing
# -----------------------------------------------------------------------------
# 每轮循环前清理这里，确保 BCM-STATE-001 的首次拉取断言真实成立。
FULL_PASS_CLEAN_DIR="/data/storage/el2/base/files/rms-cache"
FULL_PASS_STATE_RESET_CMD="\"$FULL_PASS_HDC_PATH\" -t \"$FULL_PASS_HDC_SERIAL\" shell rm -rf \"$FULL_PASS_CLEAN_DIR\""

# -----------------------------------------------------------------------------
# Atomic lifecycle commands
# -----------------------------------------------------------------------------
# 若应用已预装/预启动，可将对应 assume 标志改成 1。
FULL_PASS_ASSUME_PREINSTALLED="0"
FULL_PASS_ASSUME_PRELAUNCHED="0"
FULL_PASS_INSTALL_CMD="\"$FULL_PASS_HDC_PATH\" -t \"$FULL_PASS_HDC_SERIAL\" install -r \"$FULL_PASS_HAP_PATH\""
FULL_PASS_LAUNCH_CMD="\"$FULL_PASS_HDC_PATH\" -t \"$FULL_PASS_HDC_SERIAL\" shell aa start -a \"$FULL_PASS_ABILITY_NAME\" -b \"$FULL_PASS_PKG_NAME\""
# 按实际 UI 自动化或业务注入脚本替换该命令；默认给出最小 smoke 触发占位。
FULL_PASS_EXERCISE_CMD="\"$FULL_PASS_HDC_PATH\" -t \"$FULL_PASS_HDC_SERIAL\" shell uitest dumpLayout -b \"$FULL_PASS_PKG_NAME\""

# -----------------------------------------------------------------------------
# Runtime guardrails
# -----------------------------------------------------------------------------
FULL_PASS_TIMEOUT_SECONDS="180"
FULL_PASS_CAPTURE_WARMUP_SECONDS="2"
FULL_PASS_POST_EXERCISE_GRACE_SECONDS="3"

# -----------------------------------------------------------------------------
# Optional: module-specific notes
# -----------------------------------------------------------------------------
# FULL_PASS_NOTE="replace FULL_PASS_EXERCISE_CMD with a module-specific UI path pump"
